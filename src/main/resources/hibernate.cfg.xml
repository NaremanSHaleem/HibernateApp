<hibernate-configuration xmlns="http://www.hibernate.org/xsd/orm/cfg"
                         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                         xsi:schemaLocation="http://www.hibernate.org/xsd/orm/cfg https://www.hibernate.org/xsd/orm/cfg/hibernate-configuration-4.0.xsd">
    <session-factory>
        <property name="hibernate.connection.driver_class">org.postgresql.Driver</property>
        <property name="hibernate.connection.url">jdbc:postgresql://localhost:5432/javaProgramExample</property>
        <property name="hibernate.connection.username">naremansalamahaleem</property>
        <property name="hibernate.connection.password"></property>

        <property name="hibernate.dialect">
            org.hibernate.dialect.PostgreSQLDialect
        </property>
        <property name="hibernate.hbm2ddl.auto">update</property>
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>

    </session-factory>
</hibernate-configuration>